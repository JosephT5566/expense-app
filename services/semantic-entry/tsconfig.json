{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"types": ["node"],
		"resolveJsonModule": true,
		"allowImportingTsExtensions": true
	},
	"include": [
		"src/**/*.ts",
		"tests/**/*.ts",
		"evals/**/*.ts",
		"../../packages/semantic-entry-contract/src/**/*.ts"
	]
}
