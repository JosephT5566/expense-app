{
	"name": "@jopie/semantic-entry",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"test": "vitest run --exclude '**/db.integration.test.ts'",
		"test:integration": "vitest run tests/db.integration.test.ts",
		"check": "tsc --noEmit",
		"build": "esbuild src/server.ts --bundle --platform=node --target=node22 --format=esm --external:@langchain/* --external:@supabase/* --outfile=dist/server.js",
		"start": "node dist/server.js"
	},
	"dependencies": {
		"@jopie/semantic-entry-contract": "file:../../packages/semantic-entry-contract",
		"@langchain/core": "1.2.17",
		"@langchain/langgraph": "1.4.21",
		"@supabase/supabase-js": "2.74.0"
	},
	"devDependencies": {
		"@types/node": "^22",
		"esbuild": "0.27.4",
		"tsx": "^4.20.6",
		"typescript": "^5.9.2",
		"vitest": "5.0.3"
	}
}
